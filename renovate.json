{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "reviewers": ["unkhz"],
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)\\.khz-k3s/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "App images are built by CI and bumped by its deploy commits, not Renovate",
      "matchPackageNames": ["ghcr.io/unkhz/**"],
      "enabled": false
    }
  ]
}
